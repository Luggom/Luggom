{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capacidade base da janela principal do desktop Luggom. Os comandos da app são declarados no build.rs e exigem permissão explícita desde que o ACL entrou em vigor.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-signer-probe",
    "allow-vault-status",
    "allow-vault-create",
    "allow-vault-import",
    "allow-vault-unlock",
    "allow-vault-delete",
    "allow-vault-lock",
    "allow-vault-export-backup",
    "allow-vault-restore",
    "allow-vault-unlock-keychain",
    "allow-vault-enable-keychain",
    "allow-vault-disable-keychain",
    "allow-chain-node-url",
    "allow-chain-set-node-url",
    "allow-chain-info",
    "allow-wallet-balance",
    "allow-wallet-history",
    "allow-mining-history",
    "allow-wallet-send-plan",
    "allow-wallet-send",
    "allow-mine-providers",
    "allow-mine-load-capture",
    "allow-mine-run",
    "allow-mine-decide",
    "allow-bank-open-firefox",
    "allow-bank-status",
    "allow-bank-forget"
  ]
}
